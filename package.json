{
  "name": "wind-input-docs",
  "version": "0.0.6",
  "private": true,
  "description": "清风输入法文档站",
  "license": "MIT",
  "author": "huanfeng",
  "repository": {
    "type": "git",
    "url": "https://github.com/huanfeng/WindInputDocs"
  },
  "homepage": "https://windinput.com",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "node scripts/fetch-assets.mjs && next build && node scripts/gen-dist-files.mjs",
    "dev": "next dev",
    "start": "serve out",
    "types:check": "next typegen && fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "pnpm lint:mdx && biome check",
    "lint:mdx": "node scripts/check-mdx.mjs",
    "lint:links": "node scripts/check-links.mjs",
    "check:config": "node scripts/check-config-coverage.mjs",
    "format": "biome format --write"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "cnfast": "^0.0.8",
    "fumadocs-core": "16.11.5",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.11.5",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.17",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  }
}
