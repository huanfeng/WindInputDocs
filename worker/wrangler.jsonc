{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "windinput-dl",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"observability": {
		"enabled": true
	},
	// 路径分流：dl.windinput.com 的「底座」是 R2 自定义域（直连、不经 Worker），
	// 只在产物与 stats 两个路径上叠加窄 Worker 路由。匹配到的走 Worker（计数 +
	// 302 分流），其余请求（latest.json 等升级检查）由 R2 直接返回，不唤起
	// Worker、不耗额度。
	//
	// Worker 路由优先级高于 R2 自定义域：匹配路径归 Worker，未匹配落到 R2。
	// /api/* 必须纳入，否则 stats 会落到 R2 变 404。
	//
	// 为什么是 `WindInput-*` 而不是逐个产物列举：macOS 包名为
	// WindInput-<版本>-macOS.pkg，前缀与 WindInput-<版本>-Release.md 无法区分，
	// 而路由模式的尾部扩展名匹配（`*.pkg`）不在官方文档保证内，不值得赌。用一条
	// 前缀路由通吃，新增任何产物都不用再改这里；代价是发布说明与 .sha256 也会
	// 进 Worker——它们不匹配 ARTIFACTS 规则，不计数、不查镜像，直接 302 回 R2，
	// 只多一跳和一次调用，相对额度可忽略。
	//
	// dl-origin.* 是 EdgeOne 前置后的回源目标：dl.windinput.com 的解析交给
	// EdgeOne，CF 从第一跳变成第二跳，绑在原域名上的路由就再也匹配不上。
	// 两组路由**同时保留**——DNS 传播期间两条路都通，用户无感；旧的那组
	// 也是回滚路径，等新链路稳定几周再决定要不要摘。
	//
	// ⚠️ 光加这两条路由不够：dl-origin 还必须在 R2 桶上加同名自定义域作「底座」，
	// 否则 latest.json 一类不匹配路由的路径会 404。反过来，只加了 R2 自定义域
	// 而漏掉这两条路由更危险——下载照常成功（R2 直接吐字节流），但不计数、
	// 不走镜像分流，国内用户从此直连 R2 拉 20MB。验证时认准 302，不是 200。
	"routes": [
		{
			"pattern": "dl.windinput.com/WindInput-*",
			"zone_name": "windinput.com"
		},
		{
			"pattern": "dl.windinput.com/api/*",
			"zone_name": "windinput.com"
		},
		{
			"pattern": "dl-origin.windinput.com/WindInput-*",
			"zone_name": "windinput.com"
		},
		{
			"pattern": "dl-origin.windinput.com/api/*",
			"zone_name": "windinput.com"
		}
	],
	// 安装包字节流的实际出口。必须是**另一个**纯 R2 自定义域：dl.windinput.com 上
	// 安装包路径已被上面的 Worker 路由占用，302 回自己会打转。
	//
	// ⛔ 这里**不要**跟着上面改成 r2-origin。`dl → dl-origin` 的改名模式有很强的
	// 误导性，但两者性质相反：`*-origin` 是**回源域名**，只在 EdgeOne 与 CF 的
	// 机房之间跑；而 302 的 Location 是发给**用户浏览器**的，用户在国内，必须落
	// 到 EdgeOne 加速的 r2.windinput.com。改成 r2-origin 等于让浏览器直连 CF 拉
	// 20MB——正是这次迁移要消灭的那条路径。
	//
	// 而且这个错误在境外测不出来：两个域名都返回 200，只有国内用户卡住。
	//
	// 缓存规则相应地分两层：r2.windinput.com 的缓存配在 EdgeOne，回源域
	// r2-origin.windinput.com 的 Cache Rule 配在 CF（Eligible for cache + Edge
	// TTL）——.exe 不在 Cloudflare 默认缓存的扩展名列表里，不配这条规则回源就
	// 次次穿透到 R2。验证要用 GET 而非 HEAD：HEAD 请求恒返回 DYNAMIC。
	"vars": {
		"R2_PUBLIC_BASE": "https://r2.windinput.com"
	},
	// 镜像探活：连续 2 次失败自动下线回落 R2。10 分钟一次，一天 144 次调用，
	// 相对免费额度可忽略。
	"triggers": {
		"crons": ["*/10 * * * *"]
	},
	// database_id 由 `wrangler d1 create windinput-downloads` 输出后填入。
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "windinput-downloads",
			"database_id": "8296a7fa-7d43-4c6a-af11-d13a6239efdf",
			"remote": true
		}
	]
	// 注意：这里**不再需要 r2_buckets 绑定**。Worker 已不碰字节流，只发 302；
	// 而 in-Worker 的 R2 API 恰恰是绕过边缘缓存的那条路径，删掉它才是重点。
}
