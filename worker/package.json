{
  "name": "windinput-dl-worker",
  "version": "0.0.0",
  "private": true,
  "description": "清风输入法下载网关 Worker（下载计数 + 镜像 302 分流）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types",
    "types:check": "tsc --noEmit",
    "mirror": "node scripts/mirror.mjs",
    "db:init:local": "node scripts/d1.mjs schema.sql --local",
    "db:init:remote": "node scripts/d1.mjs schema.sql",
    "db:migrate:remote": "node scripts/d1.mjs migrations/0001-multi-platform.sql --backup downloads"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "typescript": "^6.0.3",
    "wrangler": "^4"
  }
}
