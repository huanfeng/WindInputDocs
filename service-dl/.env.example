# 复制为 .env 后填写。用 node --env-file=.env src/index.mjs 加载。
# .env 已被 .gitignore 忽略，不要提交。

# 计数与管理端点的令牌。缺失时服务拒绝启动 —— 没有它，任何人都能伪造下载量，
# 而这个数字是要展示在下载页上的。
# 生成：openssl rand -hex 32
AUTH_TOKEN=

# 监听地址。默认只听回环，公网入口应当是 EdgeOne 回源 → nginx/caddy → 本服务。
# 改成 0.0.0.0 前请想清楚 /admin/sql 的暴露面。
HOST=127.0.0.1
PORT=8080

# SQLite 库文件。备份就是拷这个文件。
DB_PATH=./data/downloads.db

# 镜像探活间隔（分钟）。与原 Worker 的 Cron 触发器一致。
PROBE_INTERVAL_MIN=10

# 由本服务直接承担下载网关（发 302），而不是只做计数后端。
#
# 仅在 EdgeOne 边缘函数开通不了时启用。它会把这台 VPS 放进下载的**关键路径**——
# 服务一挂用户就下载不了，而不再是「只丢计数」。
#
# 启用时**必须**在 EdgeOne 侧配回源故障转移，备用源站指向 R2 公共域，
# 否则单机故障 = 全站无法下载。详见 src/gateway.mjs 顶部说明。
# GATEWAY_ENABLED=1

# 网关模式下的两个跳转目标。默认值适用于正常部署，一般不用改。
# R2_PUBLIC_BASE=https://r2.windinput.com
# DOCS_BASE=https://windinput.com
